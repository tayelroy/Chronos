# chronos-soc-core (.env next to docker-compose.core.yml). scripts/deploy.sh generates
# THEHIVE_SECRET_KEY; scripts/core-bootstrap.py appends the THEHIVE_* credentials below.
THEHIVE_SECRET_KEY=change-me-thehive
THEHIVE_ADMIN_PASSWORD=
THEHIVE_ANALYST_PASSWORD=
THEHIVE_API_KEY=
# scripts/deploy.sh core: honeytoken key ids, HONEYTOKEN_READER_ROLE_ARN, HONEYTOKEN_ALERT_TOPIC_ARN
# and COMPOSE_PROFILES=honeytokens, copied from honeytokens.env (never the secrets).

# chronos-sensor (.env next to docker-compose.edge.yml). Written by scripts/deploy.sh from the
# core's private IP plus the bait key pairs in the local, gitignored honeytokens.env.
CHRONOS_CORE_ADDR=10.0.3.13:9002

# honeytokens.env (repo root on the Mac, never committed), written by scripts/honeytokens-provision.sh.
# One deny-all IAM user + key per bait, so a key-use event names the leaking file. Empty pair = bait off.
# canary GET /.env
HONEYTOKEN_DOTENV_AWS_KEY_ID=
HONEYTOKEN_DOTENV_AWS_SECRET=
# canary GET /wp-config.php.bak
HONEYTOKEN_WPCONFIG_AWS_KEY_ID=
HONEYTOKEN_WPCONFIG_AWS_SECRET=
# .env.production committed inside the dumpable /.git/ repo
HONEYTOKEN_GIT_AWS_KEY_ID=
HONEYTOKEN_GIT_AWS_SECRET=
# /root/.aws/credentials inside Cowrie's fake filesystem
HONEYTOKEN_COWRIE_AWS_KEY_ID=
HONEYTOKEN_COWRIE_AWS_SECRET=
# Honeytoken account role the core's poller assumes, and the SNS alert topic in the Chronos account
HONEYTOKEN_READER_ROLE_ARN=
HONEYTOKEN_ALERT_TOPIC_ARN=
